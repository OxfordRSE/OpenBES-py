digraph BuildingSimulationDAG {
    rankdir = TB;
    splines = ortho;
    node [shape = box];

    Geometry;
    Occupancy;
    Lighting;
    "Solar Radiation";
    Ventilation;
    Thermal;
    Cooling;
    Heating;
    "Hot Water";
    Location;

    "Solar Radiation" -> Location;
    Location -> Thermal;
    Occupancy -> Lighting;
    Lighting -> Thermal;
    Ventilation -> Thermal;
    Geometry -> Ventilation;
    Geometry -> Thermal;
    Occupancy -> Thermal;

    Geometry -> Cooling;
    Occupancy -> Cooling;
    Thermal -> Cooling;

    Geometry -> Heating;
    Occupancy -> Heating;
    Thermal -> Heating;

    Occupancy -> "Hot Water";
}
