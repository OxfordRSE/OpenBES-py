digraph BuildingSimulationDAG {
    rankdir = TB;
    splines = ortho;
    node [shape = box];

    Geometry;
    Occupancy;
    Lighting;
    "Solar Radiation";
    Ventilation;
    Climate;
    Cooling;
    Heating;
    "Hot Water";

    "Solar Radiation" -> Climate;
    Occupancy -> Lighting;
    Lighting -> Climate;
    Ventilation -> Climate;
    Geometry -> Ventilation;
    Geometry -> Climate;
    Occupancy -> Climate;

    Geometry -> Cooling;
    Occupancy -> Cooling;
    Climate -> Cooling;

    Geometry -> Heating;
    Occupancy -> Heating;
    Climate -> Heating;

    Occupancy -> "Hot Water";
}
