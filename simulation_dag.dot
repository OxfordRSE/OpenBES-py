digraph BuildingSimulationDAG {
    rankdir = TB;
    splines = ortho;
    node [shape = box];

    Geometry;
    Occupancy;
    Lighting;
    "Solar Radiation";
    Ventilation;
    Thermal;
    Cooling;
    Heating;
    "Hot Water";
    Location;


    Geometry -> Ventilation;

    Occupancy -> Lighting;
    Lighting -> Thermal;
    Ventilation -> Thermal;
    Occupancy -> Thermal;
    "Solar Radiation" -> Location;
    Location -> Thermal;

    Thermal -> Cooling;
    Thermal -> Heating;

    Occupancy -> "Hot Water";
}
